# 复制成 .env 再用：cp .env.example .env

# 登录密码（必填，只有知道它的人能进来）
NAS_PASSWORD=change-me-please

# 宿主上要被管理的目录；容器里只看得到这一个目录
NAS_HOST_DIR=/mnt/data/nas

# 证书目录。没有证书就留空目录（只开 HTTP），有证书则放 origin.crt / origin.key
NAS_CERT_DIR=./certs

# 端口：8100 给局域网，8453 给 Cloudflare 回源
NAS_PORT=8100
NAS_TLS_PORT=8453

# 0 = 不限单文件大小
NAS_MAX_UPLOAD_MB=0

# 你的域名，只用于启动日志里显示外网地址，可以空着
NAS_PUBLIC_HOST=
